# LLM provider: "mock" (offline, deterministic, default) or "openai" (any OpenAI-compatible API)
DEVPILOT_PROVIDER=mock

# OpenAI-compatible settings (OpenAI, Groq, Together, OpenRouter, local Ollama, vLLM, ...)
# Groq example:   DEVPILOT_BASE_URL=https://api.groq.com/openai/v1
# Ollama example: DEVPILOT_BASE_URL=http://localhost:11434/v1
DEVPILOT_BASE_URL=https://api.openai.com/v1
DEVPILOT_API_KEY=
DEVPILOT_MODEL=gpt-4o-mini

# Agent limits
DEVPILOT_MAX_STEPS=15
DEVPILOT_COMMAND_TIMEOUT=60

# Try to run sandboxed commands without network access (Linux, uses `unshare -rn` when available)
DEVPILOT_ISOLATE_NETWORK=true
