# LLM provider: "mock" (offline, deterministic, default) or "openai" (any OpenAI-compatible API)
DEVPILOT_PROVIDER=mock

# OpenAI-compatible settings (OpenAI, Groq, Together, OpenRouter, local Ollama, vLLM, ...)
# Groq example:   DEVPILOT_BASE_URL=https://api.groq.com/openai/v1
# Ollama example: DEVPILOT_BASE_URL=http://localhost:11434/v1
DEVPILOT_BASE_URL=https://api.openai.com/v1
DEVPILOT_API_KEY=
DEVPILOT_MODEL=gpt-4o-mini

# Agent limits
DEVPILOT_MAX_STEPS=15
DEVPILOT_COMMAND_TIMEOUT=60

# Try to run sandboxed commands without network access (Linux, uses `unshare -rn` when available)
DEVPILOT_ISOLATE_NETWORK=true

# ---------------------------------------------------------------- HTTP API (`devpilot serve`)
# Comma-separated API keys. When set, every /api call needs `X-API-Key: <key>` (or Bearer).
# When empty and DEVPILOT_DEV_MODE is off, the server runs as a public demo:
# anonymous access, bundled demo repos and the offline mock provider only.
DEVPILOT_API_KEYS=
# Local development only: disables auth (never enable on a public host)
DEVPILOT_DEV_MODE=false
# Comma-separated directories whose sub-folders may be used as `repo` (absolute paths)
DEVPILOT_REPO_ALLOWLIST=
# Comma-separated origins allowed to call the API from a browser (empty = same-origin only)
DEVPILOT_CORS_ORIGINS=
DEVPILOT_RATE_LIMIT_PER_MINUTE=60
DEVPILOT_RUN_LIMIT_PER_MINUTE=6
DEVPILOT_MAX_CONCURRENT_RUNS=2
DEVPILOT_MAX_QUEUED_RUNS=8
DEVPILOT_MAX_STEPS_CAP=30
# Trust X-Forwarded-For for client IPs (enable only behind a reverse proxy you control)
DEVPILOT_TRUST_PROXY=false
